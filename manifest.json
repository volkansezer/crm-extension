{
	"manifest_version": 3,
	"name": "Servis CRM V1.1.0",
	"version": "1.1.0",
	"description": "Servis CRM - GSPN'den Tekli kayıt çekme",
	"author": {"name": "Volkan Sezer", "email": "volkan@serviscrm.com"},

	"permissions": ["activeTab", "storage", "tabs", "scripting", "alarms", "sidePanel", "contextMenus"],
	
	"icons": {
		"16": "assets/img/icon-16.png",
		"32": "assets/img/icon-32.png",
		"48": "assets/img/icon-48.png",
		"128": "assets/img/icon-128.png"
	},

	"side_panel": {"default_path": "popup.html"},
	"background": {"service_worker": "background.js"},

	"action": {
		"default_popup": "popup.html",
		"default_icon": "assets/img/icon-128.png"
	},

	"options_ui": {
		"open_in_tab": true,
		"page": "welcome.html"
	},

	"content_scripts": [
		{
			"matches": ["https://biz1.samsungcsportal.com/gspn/operate.do"],
			"js": ["samsung/gspn.js"],
			"css": ["samsung/gspn.css"],
			"run_at": "document_end"
		},
		{
			"matches": ["https://gsfsplus-eu.lge.com/nxui/index.html"],
			"js": ["lg/lg.js"],
			"css": ["lg/lg.css"],
			"run_at": "document_end"
		}
	]

}
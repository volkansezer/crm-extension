{
  "manifest_version": 3,
  "name": "Sayfa Veri Alıcı",
  "version": "1.1",
  "description": "Açık olan sayfadan veri çeker ve popup içinde gösterir.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_popup": "popup.html"
  }
}